{
  "name": "threadmark",
  "version": "0.3.1",
  "description": "Central de suporte local-first para transformar conversas inbound do WhatsApp em contexto e tickets.",
  "keywords": [
    "whatsapp",
    "support",
    "helpdesk",
    "local-first",
    "sqlite",
    "ai"
  ],
  "homepage": "https://github.com/weslemvitor/threadmark#readme",
  "bugs": {
    "url": "https://github.com/weslemvitor/threadmark/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/weslemvitor/threadmark.git"
  },
  "license": "MIT",
  "author": "Weslem Vitor",
  "main": "dist-desktop/main.js",
  "files": [
    ".env.example",
    "bin/threadmark.mjs",
    "dist/",
    "server/",
    "shared/",
    "next.config.ts",
    "vite.config.ts"
  ],
  "bin": {
    "threadmark": "bin/threadmark.mjs"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "concurrently -k -n web,api -c blue,green \"npm:dev:web\" \"npm:dev:api\"",
    "dev:web": "vinext dev --hostname 127.0.0.1",
    "dev:api": "tsx watch server/index.ts",
    "build": "npm run typecheck && npm run build:web",
    "build:web": "tsx server/runtime/build-web.ts",
    "desktop:compile": "tsc -p tsconfig.desktop.json",
    "desktop:dev": "npm run package:build && npm run desktop:compile && electron .",
    "desktop:pack": "node bin/build-desktop.mjs dir",
    "desktop:dist": "node bin/build-desktop.mjs dmg",
    "desktop:artifact:check": "node bin/desktop-artifact-check.mjs",
    "package:build": "npm run typecheck && tsx server/runtime/build-web.ts --package",
    "package:smoke": "node bin/npm-package-smoke.mjs",
    "audit:runtime": "node bin/npm-audit-runtime.mjs",
    "privacy:check": "node bin/privacy-fixtures-check.mjs",
    "test:package": "npm run package:smoke",
    "prepack": "npm run package:build",
    "release:check": "npm run privacy:check && npm run audit:runtime && npm run test:unit && npm run lint && npm run build && npm run test:package",
    "release:desktop": "npm run release:check && npm run desktop:dist && npm run desktop:artifact:check",
    "start": "concurrently -k -n web,api -c blue,green \"npm:start:web\" \"npm:start:api\"",
    "start:web": "vinext start --hostname 127.0.0.1",
    "start:api": "tsx server/index.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.server.json",
    "test": "npm run test:unit && npm run build",
    "test:unit": "node --import tsx --test tests/*.test.ts",
    "eval:prompts": "tsx server/evals/prompt-eval.ts",
    "eval:threadmark-ai": "tsx server/evals/threadmark-ai-eval.ts",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern dist-desktop --ignore-pattern release --ignore-pattern .next",
    "seed": "tsx server/seed.ts",
    "demo:reset": "tsx server/demo-reset.ts",
    "support": "tsx server/cli.ts",
    "support:on": "tsx server/cli.ts start",
    "support:off": "tsx server/cli.ts stop",
    "support:status": "tsx server/cli.ts status"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@huggingface/transformers": "^4.2.0",
    "@modelcontextprotocol/client": "^2.0.0",
    "@vitejs/plugin-react": "6.1.0",
    "@vitejs/plugin-rsc": "0.5.34",
    "@xyflow/react": "^12.11.4",
    "baileys": "^7.0.0-rc14",
    "better-sqlite3": "^12.11.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "docx": "^9.7.1",
    "hono": "^4.13.4",
    "lucide-react": "^0.577.0",
    "next": "^16.3.3",
    "ogg-opus-decoder": "^1.7.3",
    "pdf-parse": "^2.4.5",
    "pg": "^8.23.0",
    "pg-copy-streams": "^7.0.0",
    "pino": "^10.3.1",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-server-dom-webpack": "19.2.8",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.6.0",
    "tsx": "^4.23.12",
    "tw-animate-css": "^1.4.0",
    "vinext": "0.2.1",
    "vite": "^8.2.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "22.20.1",
    "@types/pg": "^8.23.1",
    "@types/pg-copy-streams": "^1.2.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "concurrently": "^10.0.5",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.3",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  },
  "overrides": {
    "postcss": "8.5.24",
    "sharp": "0.35.3",
    "ws": "8.21.0"
  },
  "build": {
    "appId": "com.threadmark.desktop",
    "productName": "Threadmark",
    "asar": false,
    "npmRebuild": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-desktop/**/*",
      "desktop/static/**/*",
      "bin/**/*",
      "server/**/*",
      "shared/**/*",
      "package.json",
      "!server/**/*.test.ts",
      "!**/*.map"
    ],
    "mac": {
      "category": "public.app-category.business",
      "icon": "desktop/assets/threadmark-icon.icns",
      "target": [
        "dmg"
      ]
    },
    "dmg": {
      "title": "Threadmark ${version}",
      "artifactName": "Threadmark-${version}-${arch}.${ext}"
    }
  },
  "type": "module",
  "publishConfig": {
    "access": "public"
  }
}
