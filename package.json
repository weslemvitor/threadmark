{
  "name": "threadmark",
  "version": "0.3.1",
  "description": "Central de suporte local-first para transformar conversas inbound do WhatsApp em contexto e tickets.",
  "keywords": [
    "whatsapp",
    "support",
    "helpdesk",
    "local-first",
    "sqlite",
    "ai"
  ],
  "homepage": "https://github.com/weslemvitor/threadmark",
  "bugs": {
    "url": "https://github.com/weslemvitor/threadmark/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/weslemvitor/threadmark.git"
  },
  "license": "MIT",
  "author": "Weslem Vitor",
  "files": [
    ".env.example",
    "bin/threadmark.mjs",
    "dist/",
    "server/",
    "shared/",
    "next.config.ts",
    "vite.config.ts"
  ],
  "bin": {
    "threadmark": "bin/threadmark.mjs"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "concurrently -k -n web,api -c blue,green \"npm:dev:web\" \"npm:dev:api\"",
    "dev:web": "vinext dev --hostname 127.0.0.1",
    "dev:api": "tsx watch server/index.ts",
    "build": "npm run typecheck && npm run build:web",
    "build:web": "tsx server/runtime/build-web.ts",
    "package:build": "npm run typecheck && tsx server/runtime/build-web.ts --package && tsc -p tsconfig.cli.json",
    "package:smoke": "npm run package:build && node bin/npm-package-smoke.mjs",
    "audit:runtime": "node bin/npm-audit-runtime.mjs",
    "privacy:check": "node bin/privacy-fixtures-check.mjs",
    "test:package": "npm run package:smoke",
    "prepack": "npm run package:build",
    "release:check": "npm run privacy:check && npm run audit:runtime && npm run test:unit && npm run lint && npm run build && npm run test:package",
    "container:start": "tsx server/daemon.ts",
    "start": "concurrently -k -n web,api -c blue,green \"npm:start:web\" \"npm:start:api\"",
    "start:web": "vinext start --hostname 127.0.0.1",
    "start:api": "tsx server/index.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.server.json",
    "test": "npm run test:unit && npm run build",
    "test:unit": "node --import tsx --test tests/*.test.ts tests/*.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern dist-desktop --ignore-pattern release --ignore-pattern .next",
    "seed": "tsx server/seed.ts",
    "demo:reset": "tsx server/demo-reset.ts",
    "support": "tsx server/cli.ts",
    "support:on": "tsx server/cli.ts start",
    "support:off": "tsx server/cli.ts stop",
    "support:status": "tsx server/cli.ts status"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@huggingface/transformers": "^4.3.0",
    "@modelcontextprotocol/client": "^2.0.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitejs/plugin-rsc": "0.5.35",
    "@xyflow/react": "^12.11.6",
    "baileys": "^7.0.0-rc14",
    "better-sqlite3": "^12.11.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "hono": "4.13.8",
    "lucide-react": "^0.577.0",
    "next": "16.3.6",
    "ogg-opus-decoder": "^1.7.5",
    "pdf-parse": "^2.4.5",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-server-dom-webpack": "19.3.0",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.7.0",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "vinext": "1.0.0-beta.8",
    "vite": "^8.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "22.20.4",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "concurrently": "^10.0.5",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.6",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  },
  "overrides": {
    "adm-zip": "0.6.1",
    "browserslist": "4.28.8",
    "fast-uri": "3.1.6",
    "postcss": "8.5.24",
    "sharp": "0.35.4",
    "ws": "8.21.0"
  },
  "type": "module",
  "publishConfig": {
    "access": "public"
  }
}
