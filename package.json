{
  "name": "threadmark",
  "version": "0.2.0",
  "description": "Central de suporte local-first para transformar conversas inbound do WhatsApp em contexto e tickets.",
  "keywords": [
    "whatsapp",
    "support",
    "helpdesk",
    "local-first",
    "sqlite",
    "ai"
  ],
  "homepage": "https://github.com/weslemvitor/threadmark#readme",
  "bugs": {
    "url": "https://github.com/weslemvitor/threadmark/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/weslemvitor/threadmark.git"
  },
  "license": "MIT",
  "author": "Weslem Vitor",
  "files": [
    ".env.example",
    "bin/threadmark.mjs",
    "dist/",
    "server/",
    "shared/",
    "tui/api-client.ts",
    "tui/index.ts",
    "tui/model.ts",
    "tui/view.ts",
    "next.config.ts",
    "vite.config.ts"
  ],
  "bin": {
    "threadmark": "bin/threadmark.mjs"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "concurrently -k -n web,api -c blue,green \"npm:dev:web\" \"npm:dev:api\"",
    "dev:web": "vinext dev --hostname 127.0.0.1",
    "dev:api": "tsx watch server/index.ts",
    "build": "npm run typecheck && npm run build:web",
    "build:web": "tsx server/runtime/build-web.ts",
    "package:build": "npm run typecheck && tsx server/runtime/build-web.ts --package",
    "package:smoke": "node bin/npm-package-smoke.mjs",
    "audit:runtime": "node bin/npm-audit-runtime.mjs",
    "privacy:check": "node bin/privacy-fixtures-check.mjs",
    "test:package": "npm run package:smoke",
    "prepack": "npm run package:build",
    "release:check": "npm run privacy:check && npm run test:unit && npm run lint && npm run test:tui && npm run test:package",
    "start": "concurrently -k -n web,api -c blue,green \"npm:start:web\" \"npm:start:api\"",
    "start:web": "vinext start --hostname 127.0.0.1",
    "start:api": "tsx server/index.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.server.json",
    "test": "npm run test:unit && npm run build",
    "test:unit": "node --import tsx --test tests/*.test.ts",
    "eval:prompts": "tsx server/evals/prompt-eval.ts",
    "test:tui": "bun tui/tests/render-smoke.ts",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "seed": "tsx server/seed.ts",
    "demo:reset": "tsx server/demo-reset.ts",
    "support": "tsx server/cli.ts",
    "support:tui": "bun tui/index.ts",
    "support:on": "tsx server/cli.ts start",
    "support:off": "tsx server/cli.ts stop",
    "support:status": "tsx server/cli.ts status"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.10",
    "@huggingface/transformers": "^4.2.0",
    "@opentui/core": "0.4.4",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "baileys": "^7.0.0-rc14",
    "better-sqlite3": "^12.11.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "hono": "^4.12.30",
    "lucide-react": "^0.468.0",
    "next": "^16.2.12",
    "ogg-opus-decoder": "^1.7.3",
    "pdf-parse": "^2.4.5",
    "pg": "^8.22.0",
    "pg-copy-streams": "^7.0.0",
    "pino": "^10.3.1",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.6.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-server-dom-webpack": "19.2.8",
    "recharts": "^3.10.0",
    "tailwind-merge": "^3.6.0",
    "tsx": "^4.23.1",
    "tw-animate-css": "^1.4.0",
    "vinext": "0.0.50",
    "vite": "^8.1.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "22.19.19",
    "@types/pg": "^8.20.0",
    "@types/pg-copy-streams": "^1.2.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "concurrently": "^10.0.3",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.12",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  },
  "overrides": {
    "postcss": "8.5.24",
    "sharp": "0.35.3",
    "ws": "8.21.0"
  },
  "type": "module",
  "publishConfig": {
    "access": "public"
  }
}
