{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": false,
    "outDir": "dist-desktop",
    "rootDir": "desktop",
    "types": ["node"],
    "incremental": false
  },
  "include": ["desktop/**/*.ts", "desktop/**/*.cts"],
  "exclude": ["node_modules", "dist", "dist-desktop"]
}
