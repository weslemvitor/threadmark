SUPPORT_API_HOST=127.0.0.1
SUPPORT_API_PORT=4317
SUPPORT_WEB_ORIGIN=http://127.0.0.1:3000
# Origem HTTPS pública usada para CORS, CSRF e cookies no deploy.
SUPPORT_PUBLIC_ORIGIN=
SUPPORT_DATA_DIR=.data
SUPPORT_WORKSPACE_NAME=Meu workspace

SUPPORT_WHATSAPP_PHONE=
SUPPORT_WHATSAPP_NAME=Conta de suporte
# JIDs separados por virgula. Vazio = modo descoberta: salva os grupos, mas nao abre tickets.
SUPPORT_MONITORED_GROUPS=
# Telefones/JIDs/LIDs da equipe, separados por virgula. Mensagens sao salvas apenas como contexto.
SUPPORT_STAFF_IDENTITIES=
SUPPORT_WHATSAPP_ENABLED=true
SUPPORT_START_WEB=true
# O Hermes reivindica a fila pelo contrato headless. Modelo, skills e ferramentas
# do agente externo são configurados no ambiente do Hermes, fora do Git.
SUPPORT_TRIAGE_AI_ENABLED=true
SUPPORT_TRIAGE_AI_MODEL=gpt-5.4-mini
# Aguarda o fim de uma sequência curta antes de separar os assuntos.
SUPPORT_TRIAGE_AI_QUIET_MS=180000
# Prazo por operação de carregamento local ou transcrição (10 minutos).
# Ao exceder o prazo, o processo é encerrado e a fila continua no próximo áudio.
SUPPORT_AUDIO_TRANSCRIPTION_TIMEOUT_MS=600000
