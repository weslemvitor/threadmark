{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "assistantMessage",
    "phase",
    "threadSummary",
    "findings",
    "evidence",
    "suggestedResponse",
    "nextAction",
    "confidence",
    "outcome",
    "toolRequests"
  ],
  "properties": {
    "assistantMessage": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40000
    },
    "phase": {
      "type": "string",
      "enum": ["analysis", "needs_information", "conclusion"]
    },
    "threadSummary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 12000
    },
    "findings": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["statement", "kind", "evidenceReferences"],
        "properties": {
          "statement": { "type": "string", "minLength": 1, "maxLength": 4000 },
          "kind": {
            "type": "string",
            "enum": ["fact", "hypothesis", "missing_information"]
          },
          "evidenceReferences": {
            "type": "array",
            "maxItems": 10,
            "items": { "type": "string", "minLength": 1, "maxLength": 4000 }
          }
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source", "summary", "reference"],
        "properties": {
          "source": {
            "type": "string",
            "enum": [
              "conversation",
              "knowledge",
              "resolved_ticket",
              "database",
              "clickhouse",
              "aws",
              "code",
              "deployment",
              "external_app"
            ]
          },
          "summary": { "type": "string", "minLength": 1, "maxLength": 4000 },
          "reference": { "type": ["string", "null"], "maxLength": 4000 }
        }
      }
    },
    "suggestedResponse": {
      "type": ["string", "null"],
      "minLength": 1,
      "maxLength": 20000
    },
    "nextAction": {
      "type": ["string", "null"],
      "minLength": 1,
      "maxLength": 8000
    },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "objectiveStatus",
        "rootCauseStatus",
        "causalClassification",
        "rootCause",
        "rootCauseEvidenceReferences",
        "unresolvedCriticalQuestions",
        "stopReason"
      ],
      "properties": {
        "objectiveStatus": {
          "type": "string",
          "enum": ["answered", "partially_answered", "unanswered"]
        },
        "rootCauseStatus": {
          "type": "string",
          "enum": ["confirmed", "probable", "unknown", "not_applicable"]
        },
        "causalClassification": {
          "type": "string",
          "enum": [
            "code",
            "configuration",
            "data",
            "infrastructure",
            "provider",
            "process",
            "unknown",
            "not_applicable"
          ]
        },
        "rootCause": {
          "type": ["string", "null"],
          "minLength": 1,
          "maxLength": 8000
        },
        "rootCauseEvidenceReferences": {
          "type": "array",
          "maxItems": 10,
          "items": { "type": "string", "minLength": 1, "maxLength": 4000 }
        },
        "unresolvedCriticalQuestions": {
          "type": "array",
          "maxItems": 20,
          "items": { "type": "string", "minLength": 1, "maxLength": 2000 }
        },
        "stopReason": {
          "type": "string",
          "enum": [
            "cause_confirmed",
            "evidence_exhausted",
            "external_blocker",
            "not_applicable"
          ]
        }
      }
    },
    "toolRequests": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "requestId",
          "toolId",
          "operation",
          "argumentsJson",
          "purpose"
        ],
        "properties": {
          "requestId": { "type": "string", "minLength": 1, "maxLength": 100 },
          "toolId": { "type": "string", "minLength": 1, "maxLength": 200 },
          "operation": { "type": "string", "minLength": 1, "maxLength": 100 },
          "argumentsJson": { "type": "string", "minLength": 2, "maxLength": 20000 },
          "purpose": { "type": "string", "minLength": 1, "maxLength": 1000 }
        }
      }
    }
  }
}
