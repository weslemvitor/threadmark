{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["groups"],
  "properties": {
    "groups": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "messageIds",
          "contextMessageIds",
          "kind",
          "suggestedAction",
          "relatedTicketId",
          "relatedSuggestionId",
          "title",
          "summary",
          "affectedEcommerce",
          "categories",
          "reason",
          "confidence"
        ],
        "properties": {
          "messageIds": {
            "type": "array",
            "minItems": 1,
            "maxItems": 50,
            "items": { "type": "string", "minLength": 1 }
          },
          "contextMessageIds": {
            "type": "array",
            "maxItems": 50,
            "items": { "type": "string", "minLength": 1 }
          },
          "kind": {
            "type": "string",
            "enum": ["demand", "uncertain", "continuation", "information", "social"]
          },
          "suggestedAction": {
            "type": "string",
            "enum": ["create", "attach", "ignore", "wait"]
          },
          "relatedTicketId": { "type": ["string", "null"] },
          "relatedSuggestionId": { "type": ["string", "null"] },
          "title": { "type": "string", "minLength": 1, "maxLength": 200 },
          "summary": { "type": "string", "minLength": 1, "maxLength": 4000 },
          "affectedEcommerce": { "type": ["string", "null"] },
          "categories": {
            "type": "object",
            "additionalProperties": false,
            "required": ["contactReason", "productArea", "platform", "symptom"],
            "properties": {
              "contactReason": {
                "type": "array",
                "maxItems": 1,
                "items": { "type": "string" }
              },
              "productArea": {
                "type": "array",
                "maxItems": 1,
                "items": { "type": "string" }
              },
              "platform": {
                "type": "array",
                "maxItems": 3,
                "items": { "type": "string" }
              },
              "symptom": {
                "type": "array",
                "maxItems": 1,
                "items": { "type": "string" }
              }
            }
          },
          "reason": { "type": "string", "minLength": 1, "maxLength": 1000 },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    }
  }
}
